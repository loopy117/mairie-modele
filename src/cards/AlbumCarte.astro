---
import Img from '../components/Img.astro';
import { urlElement } from '../lib/urls';
import { dateLongue } from '../lib/publication';
const { element } = Astro.props;
const d = element.data;
const couverture = d.image ?? d.photos?.[0];
const n = d.photos?.length ?? 0;
---
<article class="alc">
  <div class="alc__media" aria-hidden="true">
    {couverture && <Img image={{ ...couverture, alt: '' }} sizes="(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw" largeurs={[480, 800]} />}
    <span class="alc__nb">{n} photo{n > 1 ? 's' : ''}</span>
  </div>
  <div class="alc__corps">
    <p class="alc__date"><time datetime={new Date(d.date).toISOString().slice(0, 10)}>{dateLongue(d.date)}</time></p>
    <h3 class="alc__titre"><a href={urlElement('albums', element.id)}>{d.titre}<span class="visually-hidden"> ({n} photo{n > 1 ? 's' : ''})</span></a></h3>
  </div>
</article>
<style>
  .alc { position: relative; height: 100%; display: flex; flex-direction: column; border-radius: var(--radius-lg); overflow: hidden; background: var(--c-surface); border: 1px solid var(--c-border); }
  .alc__media { position: relative; aspect-ratio: 4 / 3; background: var(--c-surface-alt); }
  .alc__media :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .alc__nb { position: absolute; right: 12px; bottom: 12px; background: rgb(0 0 0 / 0.72); color: #fff; font-size: 13px; font-weight: 600; padding: 4px 10px; border-radius: var(--radius-pill); }
  .alc__corps { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 4px; }
  .alc__date { font-size: 13px; color: var(--c-text-muted); }
  .alc__titre { font-size: 18px; line-height: 1.3; } .alc__titre a { color: var(--c-text); } .alc__titre a::after { content: ''; position: absolute; inset: 0; }
  .alc:has(a:focus-visible) { outline: 3px solid var(--c-link); outline-offset: 2px; } .alc__titre a:focus-visible { outline: none; }
</style>
