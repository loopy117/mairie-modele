---
import { urlElement } from '../lib/urls';
import { TYPES_ANNUAIRE } from '../schemas/collections';
const { element } = Astro.props;
const d = element.data;
const tel = d.telephone ? 'tel:' + d.telephone.replace(/[^\d+]/g, '').replace(/^0/, '+33') : null;
---
<article class="af">
  <p class="af__type">{(TYPES_ANNUAIRE as Record<string, string>)[d.type]}</p>
  <h3 class="af__nom"><a href={urlElement('annuaire', element.id)}>{d.titre}</a></h3>
  {d.resume && <p class="af__resume">{d.resume}</p>}
  <ul class="af__contacts">
    {d.telephone && <li><a href={tel}>{d.telephone}</a></li>}
    {d.email && <li><a href={`mailto:${d.email}`}>{d.email}</a></li>}
  </ul>
</article>
<style>
  .af { height: 100%; padding: 20px 22px; border: 1px solid var(--c-border); border-radius: var(--radius-lg); background: var(--c-surface); display: flex; flex-direction: column; gap: 8px; }
  .af__type { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--c-text-muted); }
  .af__nom { font-size: 18px; font-weight: 700; line-height: 1.3; } .af__nom a { color: var(--c-text); }
  .af__resume { font-size: 15px; color: var(--c-text-body); }
  .af__contacts { list-style: none; margin: auto 0 0; padding: 0; display: flex; flex-direction: column; gap: 4px; font-size: 15px; word-break: break-word; }
</style>
