---
import Img from '../components/Img.astro';
import Embleme from '../partials/Embleme.astro';
import { urlElement } from '../lib/urls';
import { dateLongue } from '../lib/publication';
import taxonomies from '../../data/taxonomies.json';
const { element } = Astro.props;
const d = element.data;
const theme = (taxonomies.metiers as Record<string, string>)[d.categorie];
---
<article class="ac" data-metier={d.categorie}>
  <div class="ac__media" aria-hidden="true">
    {d.image ? <Img image={{ ...d.image, alt: '' }} sizes="(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw" largeurs={[480, 800, 1200]} /> : <Embleme hauteur={120} class="ac__embleme" />}
    {theme && <span class="ac__theme">{theme}</span>}
  </div>
  <div class="ac__corps">
    <p class="ac__meta"><time datetime={new Date(d.date).toISOString().slice(0, 10)}>{dateLongue(d.date)}</time>{theme && <span class="visually-hidden"> · {theme}</span>}</p>
    <h3 class="ac__titre"><a href={urlElement('actualites', element.id)}>{d.titre}</a></h3>
    {d.resume && <p class="ac__resume">{d.resume}</p>}
  </div>
</article>
<style>
  .ac { position: relative; height: 100%; background: #fff; border-radius: var(--radius-xl); overflow: hidden; border: 1px solid var(--c-border); display: flex; flex-direction: column; transition: transform .15s, box-shadow .15s; }
  .ac:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgb(29 34 48 / 0.08); }
  .ac__media { position: relative; aspect-ratio: 16 / 10; background: var(--metier-soft); display: grid; place-items: center; overflow: hidden; }
  .ac__media :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ac__media :global(.ac__embleme) { position: static !important; width: auto !important; height: 62% !important; opacity: .25; }
  .ac__theme { position: absolute; top: 14px; left: 14px; background: var(--metier); color: #fff; font-weight: 700; font-size: 13px; padding: 6px 12px; border-radius: var(--radius-pill); }
  .ac__corps { padding: 20px 22px 24px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .ac__meta { font-size: 14px; font-weight: 600; color: var(--metier-ink); }
  .ac__titre { font-size: var(--fs-h3); font-weight: 700; line-height: 1.15; letter-spacing: -0.01em; color: var(--c-text); }
  .ac__titre a { color: inherit; }
  .ac__titre a:hover { color: var(--c-primary); text-decoration: underline; }
  .ac__titre a::after { content: ''; position: absolute; inset: 0; }
  .ac__titre a:focus-visible { outline: none; box-shadow: none; } .ac:has(a:focus-visible) { outline: 3px solid var(--c-soleil); outline-offset: 3px; box-shadow: 0 0 0 6px var(--c-ink); }
  .ac__resume { font-size: 15px; line-height: 1.5; color: var(--c-text-body); }
  @media (prefers-reduced-motion: reduce) { .ac, .ac:hover { transition: none; transform: none; } }
</style>
