---
import Img from '../components/Img.astro';
import { urlElement } from '../lib/urls';
import { dateLongue } from '../lib/publication';
import taxonomies from '../../data/taxonomies.json';
const { element } = Astro.props;
const d = element.data;
const theme = (taxonomies.metiers as Record<string, string>)[d.categorie];
---
<article class="ac" data-metier={d.categorie}>
  {d.image && <div class="ac__media"><Img image={d.image} sizes="(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw" largeurs={[480, 800, 1200]} /></div>}
  <div class="ac__corps">
    <p class="ac__meta"><time datetime={new Date(d.date).toISOString().slice(0, 10)}>{dateLongue(d.date)}</time>{theme && <> · {theme}</>}</p>
    <h3 class="ac__titre"><a href={urlElement('actualites', element.id)}>{d.titre}</a></h3>
    {d.resume && <p class="ac__resume">{d.resume}</p>}
  </div>
</article>
<style>
  .ac { position: relative; height: 100%; background: var(--c-surface); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--c-border); transition: box-shadow .2s; display: flex; flex-direction: column; }
  .ac:hover { box-shadow: 0 10px 30px oklch(0.25 0.03 255 / 0.1); }
  .ac__media :global(img) { width: 100%; height: 180px; object-fit: cover; }
  .ac__corps { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 8px; }
  .ac__meta { font-size: 13px; color: var(--c-text-muted); }
  .ac__titre { font-size: 18px; font-weight: 700; line-height: 1.3; color: var(--c-text); }
  .ac__titre a { color: inherit; }
  .ac__titre a::after { content: ''; position: absolute; inset: 0; }
  .ac__titre a:focus-visible { outline: none; } .ac:has(a:focus-visible) { outline: 3px solid var(--c-link); outline-offset: 2px; }
  .ac__resume { font-size: var(--fs-base); line-height: var(--lh-body); color: var(--c-text-body); }
</style>
