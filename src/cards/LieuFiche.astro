---
import { urlElement } from '../lib/urls';
import { TYPES_LIEUX } from '../schemas/collections';
const { element } = Astro.props;
const d = element.data;
const pmr = { oui: 'Accessible PMR', partiel: 'Accès PMR partiel', non: 'Non accessible PMR' } as Record<string, string>;
---
<article class="lf">
  <p class="lf__type">{(TYPES_LIEUX as Record<string, string>)[d.type]}</p>
  <h3 class="lf__nom"><a href={urlElement('lieux', element.id)}>{d.titre}</a></h3>
  {d.adresse && <p class="lf__adr">{d.adresse}</p>}
  {d.pmr && <p class:list={['lf__pmr', `lf__pmr--${d.pmr}`]}>{pmr[d.pmr]}</p>}
</article>
<style>
  .lf { position: relative; height: 100%; padding: 18px 20px; border: 1px solid var(--c-border); border-radius: var(--radius-lg); background: var(--c-surface); display: flex; flex-direction: column; gap: 6px; }
  .lf__type { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--c-text-muted); }
  .lf__nom { font-size: 18px; font-weight: 700; line-height: 1.3; } .lf__nom a { color: var(--c-text); } .lf__nom a::after { content: ''; position: absolute; inset: 0; }
  .lf:has(a:focus-visible) { outline: 3px solid var(--c-link); outline-offset: 2px; } .lf__nom a:focus-visible { outline: none; }
  .lf__adr { font-size: 15px; color: var(--c-text-body); }
  .lf__pmr { align-self: flex-start; font-size: 13px; font-weight: 600; padding: 2px 10px; border-radius: var(--radius-pill); background: #e3f1e8; color: #1f5c3a; }
  .lf__pmr--partiel { background: #fdf0d9; color: #6b4300; } .lf__pmr--non { background: #eef1f5; color: #3d4a5c; }
</style>
