---
import Img from '../components/Img.astro';
import Avancement from '../components/Avancement.astro';
import { urlElement } from '../lib/urls';
const { element } = Astro.props;
const d = element.data;
---
<article class="pc">
  {d.image && <div class="pc__media"><Img image={d.image} sizes="(min-width: 1000px) 50vw, 100vw" largeurs={[480, 800, 1200]} /></div>}
  <div class="pc__corps">
    <h3 class="pc__titre"><a href={urlElement('projets', element.id)}>{d.titre}</a></h3>
    {d.resume && <p class="pc__resume">{d.resume}</p>}
    <Avancement avancement={d.avancement} compact />
    {(d.budget || d.lieu) && <p class="pc__infos">{[d.lieu, d.budget].filter(Boolean).join(' · ')}</p>}
  </div>
</article>
<style>
  .pc { position: relative; height: 100%; border: 1px solid var(--c-border); border-radius: var(--radius-lg); overflow: hidden; background: var(--c-surface); display: flex; flex-direction: column; }
  .pc__media :global(img) { width: 100%; height: 200px; object-fit: cover; }
  .pc__corps { padding: 20px 22px; display: flex; flex-direction: column; gap: 12px; }
  .pc__titre { font-size: 20px; font-weight: 700; line-height: 1.3; } .pc__titre a { color: var(--c-text); } .pc__titre a::after { content: ''; position: absolute; inset: 0; }
  .pc:has(a:focus-visible) { outline: 3px solid var(--c-link); outline-offset: 2px; } .pc__titre a:focus-visible { outline: none; }
  .pc__resume { color: var(--c-text-body); } .pc__infos { font-size: 14px; color: var(--c-text-muted); }
</style>
