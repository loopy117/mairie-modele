---
import { urlElement } from '../lib/urls';
import { THEMES_INFOS } from '../schemas/collections';
const { element } = Astro.props;
const d = element.data;
---
<article class="ic">
  <p class="ic__theme">{(THEMES_INFOS as Record<string, string>)[d.theme]}</p>
  <h3 class="ic__titre"><a href={urlElement('infos', element.id)}>{d.titre}</a></h3>
  {d.resume && <p class="ic__resume">{d.resume}</p>}
</article>
<style>
  .ic { position: relative; height: 100%; padding: 20px 22px; border: 1px solid var(--c-border); border-left: 5px solid var(--c-accent); border-radius: var(--radius-lg); background: var(--c-surface); display: flex; flex-direction: column; gap: 8px; }
  .ic__theme { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--c-accent-text); font-weight: 600; }
  .ic__titre { font-size: 18px; font-weight: 700; line-height: 1.3; } .ic__titre a { color: var(--c-text); } .ic__titre a::after { content: ''; position: absolute; inset: 0; }
  .ic:has(a:focus-visible) { outline: 3px solid var(--c-link); outline-offset: 2px; } .ic__titre a:focus-visible { outline: none; }
  .ic__resume { font-size: 15px; color: var(--c-text-body); }
</style>
