---
// Polices hébergées avec le site (paquets @fontsource), propres à chaque site : src/site/polices.ts
import * as polices from '../site/polices';
const prechargees = [...new Set([(polices as any).policeTitre, (polices as any).policeTexte].filter(Boolean))] as string[];
import '../styles/tokens.css';
import '../styles/base.css';
// Retouches propres au site (fichier du site, chargé après le socle)
import '../site/site.css';
import Header from '../partials/Header.astro';
import Footer from '../partials/Footer.astro';
import BoutonModifier from '../partials/BoutonModifier.astro';
import FilAriane from '../partials/FilAriane.astro';
import siteBrut from '../../data/site.json';
import partage from '../../data/partage.json';
import type { Site } from '../schemas/site';
import { reglages } from '../lib/collections';
import { graphe, type TypePage } from '../lib/donnees-structurees';
const site = siteBrut as unknown as Site;

interface Props {
  titre: string;
  seo?: { titre?: string; description?: string; noindex?: boolean };
  url: string;
  gabarit?: 'standard' | 'pleine-largeur' | 'landing';
  filAriane?: boolean;
  /** Données structurées propres à la page (ex. Service), ajoutées au graphe entreprise + site + page. */
  jsonld?: Record<string, unknown>[];
  typePage?: TypePage;
}
const { titre, seo = {}, url, gabarit = 'standard', filAriane = url !== '/', jsonld = [], typePage } = Astro.props;
const titreSeo = seo.titre ?? `${titre} — ${site.nom}`;
const base = Astro.site?.href.replace(/\/$/, '') ?? site.url;
const canonique = base + (url === '/' ? '/' : url);
// Recherche (Pagefind) : pages indexables seulement (pas 404, merci, recherche), avec leur type comme filtre.
// NOINDEX (site en recette) n'empêche pas la recherche interne.
const [seg1, seg2] = url.split('/').filter(Boolean);
const collectionUrl = seg2 && seg2 !== 'categorie' ? Object.values(reglages).find((r) => r.detail && r.base.replace(/^\//, '') === seg1) : undefined;
const typeRecherche = collectionUrl?.libelle ?? 'Pages';
const indexerRecherche = !seo.noindex && url !== '/recherche' && !url.startsWith('/plan-du-site') && seg2 !== 'categorie';   // pages de catégorie : doublons des archives
const noindex = seo.noindex || import.meta.env.NOINDEX === '1' || process.env.NOINDEX === '1';
// Pas de données structurées sur une page non indexable (404, remerciement…)
// Image de partage (réseaux sociaux) générée au build par scripts/partage.mjs, une par page indexable
const imagePartage = seo.noindex ? null : `${base}/partage/${url === '/' ? 'accueil' : url.replace(/^\/|\/$/g, '').replace(/\//g, '--')}.png`;
const donnees = seo.noindex ? [] : [graphe(site, base, { url, titre, description: seo.description, type: typePage, extras: jsonld })];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreSeo}</title>
    {seo.description && <meta name="description" content={seo.description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonique} />
    <meta property="og:title" content={titreSeo} />
    {seo.description && <meta property="og:description" content={seo.description} />}
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonique} />
    <meta property="og:site_name" content={site.nom} />
    {imagePartage && <meta property="og:image" content={imagePartage} />}
    {imagePartage && <meta property="og:image:width" content="1200" />}
    {imagePartage && <meta property="og:image:height" content="630" />}
    {imagePartage && <meta property="og:image:alt" content={titreSeo} />}
    <meta name="twitter:card" content={imagePartage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    {partage.favicon_svg && <link rel="icon" href="/favicon.svg" type="image/svg+xml" />}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={partage.fond} />
    {prechargees.map((p) => <link rel="preload" href={p} as="font" type="font/woff2" crossorigin />)}
    {donnees.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    <a class="lien-evitement" href="#menu">Aller au menu</a>
    <Header courant={url} landing={gabarit === 'landing'} />
    <main id="contenu" tabindex="-1" {...(indexerRecherche ? { 'data-pagefind-body': '', 'data-pagefind-filter': `type:${typeRecherche}`, 'data-pagefind-meta': `title:${url === '/' ? `Accueil · ${site.nom}` : titre}` } : {})}>
      {filAriane && <FilAriane url={url} titre={titre} />}
      <slot />
    </main>
    <Footer />
    <BoutonModifier />
  </body>
</html>
