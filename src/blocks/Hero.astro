---
import Img from '../components/Img.astro';
import Boutons from '../components/Boutons.astro';
import Sillage from '../components/Sillage.astro';
import { composantsIllustrations } from '../illustrations';
import Silhouette from '../partials/Silhouette.astro';
const { variant = 'plein-ecran', background = 'clair', spacing, id, surtitre, titre, texte, image, illustration, ctas = [], points = [], accent, recherche } = Astro.props;
// Variante commune : un mot du titre en couleur
const [avant, apres] = accent && titre.includes(accent) ? [titre.slice(0, titre.indexOf(accent)), titre.slice(titre.indexOf(accent) + accent.length)] : [titre, ''];
const Illustration = illustration ? composantsIllustrations[illustration.nom as keyof typeof composantsIllustrations] : null;
const sombre = variant === 'plein-ecran' || variant === 'commune' || background === 'sombre' || background === 'accent' || background === 'sillage-sombre';
---
{variant === 'commune' ? (
<section id={id} class="hero hero--commune on-dark" aria-labelledby="titre-accueil">
  <div class="container hc__grille">
    <div class="hc__texte">
      {surtitre && <p class="hc__pastille">{surtitre}</p>}
      <h1 id="titre-accueil" class="hc__titre">{avant}{accent && <span class="hc__accent">{accent}</span>}{apres}</h1>
      {texte && <p class="hc__intro">{texte}</p>}
      {recherche && (
        <form id="recherche" class="hc__recherche" role="search" action="/recherche" method="get">
          <label for="champ-recherche" class="hc__label">{recherche.label}</label>
          <div class="hc__champ">
            <input id="champ-recherche" name="q" type="search" autocomplete="off" aria-describedby={recherche.exemples ? 'aide-recherche' : undefined} />
            <button type="submit">Rechercher</button>
          </div>
          {recherche.exemples && <p id="aide-recherche" class="hc__aide">Exemples : {recherche.exemples}</p>}
        </form>
      )}
      <Boutons ctas={ctas} />
    </div>
    {image && <div class="hc__media"><Img image={image} priorite sizes="(min-width: 1000px) 46vw, 100vw" largeurs={[640, 960, 1280]} /></div>}
  </div>
  <Silhouette blanc class="hc__silhouette" />
</section>
) : (
<section id={id} class:list={['hero', `hero--${variant}`, `bg-${variant === 'plein-ecran' ? 'sombre' : background}`, `sp-${spacing}`, sombre && 'on-dark']}>
  {variant !== 'plein-ecran' && background.startsWith('sillage') && <Sillage variante={background === 'sillage' ? 'clair' : 'sombre'} />}
  {variant === 'plein-ecran' && image && (
    <div class="hero__media" aria-hidden={image.alt ? undefined : 'true'}>
      <Img image={image} priorite sizes="100vw" class="hero__img" />
      <div class="hero__voile"></div>
    </div>
  )}
  <div class="container hero__grille">
    <div class="hero__texte">
      {surtitre && (variant === 'split'
        ? <p class="eyebrow hero__surtitre">{surtitre}</p>
        : <p class="hero__pastille"><span class="point" aria-hidden="true"></span>{surtitre}</p>)}
      <h1 class="hero__titre">{titre}</h1>
      {texte && <p class="hero__intro">{texte}</p>}
      <Boutons ctas={ctas} />
      {points.length > 0 && (
        <ul class="hero__points">{points.map((p: string) => <li>{p}</li>)}</ul>
      )}
    </div>
    {variant === 'split' && image && (
      <div class="hero__split-media"><Img image={image} priorite sizes="(min-width: 900px) 50vw, 100vw" class="hero__img" /></div>
    )}
    {variant === 'split' && !image && Illustration && (
      <div class="hero__split-media"><Illustration {...illustration} /></div>
    )}
  </div>
</section>
)}

<style>
  .hero { position: relative; overflow: hidden; }
  .bg-clair { background: var(--c-surface); }
  .bg-alt { background: var(--c-surface-alt); }
  .bg-sombre { background: var(--c-surface-dark); }
  .bg-accent { background: var(--c-surface-accent, var(--c-primary)); }
  .bg-sillage { background: var(--c-surface); }
  .bg-sillage-sombre { background: var(--c-surface-dark); }
  .hero__grille { position: relative; z-index: 1; }
  .hero__texte { max-width: 660px; display: flex; flex-direction: column; gap: 22px; }
  .hero__pastille { align-self: flex-start; display: inline-flex; align-items: center; gap: 9px; padding: 7px 14px; border-radius: var(--radius-pill); background: var(--c-primary); color: #fff; font-size: 12.5px; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; }
  .point { width: 7px; height: 7px; border-radius: 50%; background: var(--c-accent); flex: none; }
  .hero__titre { font-size: var(--fs-h1); font-weight: 700; letter-spacing: -0.025em; line-height: 1.04; color: var(--c-text); }
  .hero__intro { font-size: var(--fs-lg); line-height: var(--lh-body); color: var(--c-text-muted); max-width: 560px; }
  .hero__points { list-style: none; margin: 0; padding: 8px 0 0; display: flex; flex-wrap: wrap; gap: 10px 26px; }
  .hero__points li { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--c-text-muted); }
  .hero__points li::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: oklch(0.70 0.13 158); }
  :global(.on-dark) .hero__titre { color: var(--c-on-dark); }
  :global(.on-dark) .hero__intro { color: var(--c-on-dark-body); }
  :global(.on-dark) .hero__points li { color: oklch(0.86 0.01 160); }

  /* plein-écran : photo en fond, voile dégradé à gauche */
  .hero--plein-ecran { min-height: 520px; display: flex; align-items: center; }
  .hero--plein-ecran .hero__grille { padding-block: 64px; }
  .hero__media { position: absolute; inset: 0; }
  .hero__media :global(img), .hero__media :global(picture) { width: 100%; height: 100%; object-fit: cover; }
  .hero__voile { position: absolute; inset: 0; background: linear-gradient(100deg, oklch(0.25 0.05 260 / 0.94) 0%, oklch(0.25 0.05 260 / 0.8) 42%, oklch(0.25 0.05 260 / 0.12) 78%, oklch(0.25 0.05 260 / 0) 100%); }
  @media (max-width: 760px) { .hero__voile { background: oklch(0.25 0.05 260 / 0.82); } }

  /* split : texte à gauche, image ou illustration à droite */
  .hero--split { padding-block: clamp(56px, 7.2vw, 104px) clamp(64px, 7.8vw, 112px); }
  .hero--split .hero__grille { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr)); gap: clamp(40px, 5vw, 72px); align-items: center; }
  .hero--split .hero__texte { gap: 32px; }
  .hero--split .hero__titre { font-weight: 500; line-height: 1.02; }
  .hero--split .hero__intro { font-size: var(--fs-xl); color: var(--c-text-body); max-width: 560px; }
  .hero--split .hero__points { padding: 0; gap: 10px 28px; }
  .hero--split .hero__points li { font-size: 15px; color: var(--c-text-muted); }
  .hero--split .hero__points li::before { display: none; }
  .hero--split :global(.boutons) { gap: 16px; }
  .hero--split :global(.btn--secondaire) { padding-inline: 26px; }
  .hero__split-media :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-xl); }

  /* commune : fond bleu, pastille jaune, recherche, photo arrondie, silhouette du village */
  .hero--commune { background: var(--c-primary); color: #fff; }
  .hc__grille { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 48px; align-items: center; padding-block: 56px clamp(110px, 15vw, 220px); }
  .hc__texte { display: flex; flex-direction: column; align-items: flex-start; }
  .hc__pastille { background: var(--c-soleil); color: var(--c-ink); font-weight: 700; font-size: 14px; padding: 6px 14px; border-radius: var(--radius-pill); }
  .hc__titre { font-size: var(--fs-h1); font-weight: 800 !important; line-height: .95; letter-spacing: -0.03em; margin: 22px 0 20px; color: #fff; }
  .hc__accent { color: var(--c-soleil); }
  .hc__intro { font-size: var(--fs-lg); line-height: 1.5; max-width: 520px; color: var(--c-on-dark-body); margin-bottom: 32px; }
  .hc__recherche { width: 100%; max-width: 560px; }
  .hc__label { display: block; font-size: 15px; font-weight: 700; margin-bottom: 8px; }
  .hc__champ { display: flex; gap: 6px; background: #fff; border-radius: var(--radius-pill); padding: 6px 6px 6px 22px; }
  .hc__champ:focus-within { outline: 3px solid var(--c-soleil); outline-offset: 3px; }
  .hc__champ input { flex: 1; min-width: 0; border: 0; font: inherit; font-size: 16px; background: transparent; color: var(--c-ink); }
  .hc__champ input:focus-visible { outline: none; box-shadow: none; }
  .hc__champ button { border: 0; background: var(--c-accent); color: #fff; font: inherit; font-weight: 700; font-size: 15px; padding: 13px 22px; border-radius: var(--radius-pill); cursor: pointer; }
  .hc__champ button:hover { background: #9C1249; }
  .hc__aide { margin-top: 10px; font-size: 14px; color: var(--c-on-dark-body); }
  .hc__texte :global(.boutons) { margin-top: 24px; }
  .hc__media :global(img) { width: 100%; aspect-ratio: 5 / 4; object-fit: cover; border-radius: 28px 28px 28px 4px; }
  .hero--commune :global(.hc__silhouette) { position: absolute; left: 0; right: 0; bottom: -2px; opacity: .55; }

  /* minimal : titre et texte, sans image */
  .hero--minimal { padding-block: 56px 32px; }
  .hero--minimal.bg-clair { background: var(--c-surface-alt); }
  .hero--minimal .hero__titre { font-size: clamp(30px, 4vw, 46px); }
</style>
