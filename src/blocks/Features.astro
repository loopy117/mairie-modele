---
import Section from '../components/Section.astro';
import Icone from '../components/Icone.astro';
import { composantsIllustrations } from '../illustrations';
import Img from '../components/Img.astro';
import { COULEURS } from '../schemas/communs';
const { variant = 'grille-icones', background, spacing, id, surtitre, titre, intro, items = [], illustration } = Astro.props;
const Balise = variant === 'etapes-numerotees' ? 'ol' : 'ul';
const Illustration = illustration ? composantsIllustrations[illustration.nom as keyof typeof composantsIllustrations] : null;
// Variante « paires » : items regroupés deux par carte
const groupes: any[][] = variant === 'paires'
  ? items.reduce((g: any[][], it: any, i: number) => (i % 2 ? g[g.length - 1].push(it) : g.push([it]), g), [])
  : items.map((it: any) => [it]);
// Titres des cartes : h3 sous le titre de la section, h2 si la section n'en a pas (hiérarchie sans saut, RGAA 9.1)
const Titre = titre ? 'h3' : 'h2';
// Tuiles et rubriques : couleur de l'item, sinon en alternance
const coul = (it: any, i: number) => it.couleur ?? COULEURS[i % COULEURS.length];
const styleCoul = (it: any, i: number) => `--rub: var(--c-${coul(it, i)}); --rub-soft: var(--c-${coul(it, i)}-soft)`;
const cartesLiens = variant === 'tuiles' || variant === 'rubriques';
---
<Section {background} {spacing} {id} {surtitre} {titre} {intro}>
  {cartesLiens ? (
  <ul class:list={['ft', `ft--${variant}`]}>
    {items.map((it: any, i: number) => (
      <li class="lc" style={styleCoul(it, i)}>
        <a class="lc__lien" href={it.lien?.href}>
          {variant === 'tuiles' && <span class="lc__point" aria-hidden="true"></span>}
          {variant === 'rubriques' && it.image && <span class="lc__media"><Img image={{ ...it.image, alt: '' }} sizes="(min-width: 1100px) 20vw, (min-width: 640px) 33vw, 100vw" largeurs={[320, 480, 720]} /></span>}
          <span class="lc__corps">
            <Titre class="lc__titre">{it.titre}</Titre>
            {it.texte && <span class="lc__texte">{it.texte}</span>}
          </span>
        </a>
      </li>
    ))}
  </ul>
  ) : (
  <Balise class:list={['ft', `ft--${variant}`]}>
    {Illustration && <li class="ft__illustration"><Illustration {...illustration} /></li>}
    {groupes.map((g, gi) => (
      <li class:list={['ft__item', g[0].mis_en_avant && variant !== 'liste' && 'ft__item--avant']}>
        {g.map((it: any, k: number) => (
          <>
            {it.mis_en_avant && it.badge && <span class="ft__badge">{it.badge}</span>}
            {variant === 'etapes-numerotees'
              ? <span class="ft__num" aria-hidden="true">{gi + 1}</span>
              : variant !== 'comparatif' && variant !== 'paires' && it.icone && <span class="ft__icone"><Icone nom={it.icone} taille={22} /></span>}
            <div class="ft__corps">
              {variant === 'comparatif' ? <Titre class="ft__etiquette">{it.titre}</Titre> : <Titre class="ft__titre">{it.titre}</Titre>}
              {it.texte && <p class="ft__texte">{it.texte}</p>}
              {it.lien && <a class="link-more" href={it.lien.href}>{it.lien.label}</a>}
            </div>
          </>
        ))}
      </li>
    ))}
  </Balise>
  )}
</Section>
<style>
  /* tuiles : raccourcis teintés, point de couleur */
  .ft--tuiles { grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: 12px; }
  @media (max-width: 560px) { .ft--tuiles { grid-template-columns: 1fr 1fr; gap: 10px; } .ft--tuiles .lc__lien { padding: 16px; min-height: 0; } .ft--tuiles .lc__titre { font-size: 16px; } }
  .ft--rubriques { grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); gap: 16px; }
  .lc { display: flex; }
  .lc__lien { flex: 1; display: flex; flex-direction: column; border-radius: var(--radius-lg); color: var(--c-text); transition: transform .15s; }
  .lc__lien:hover { color: var(--c-text); transform: translateY(-2px); }
  .lc__titre { font-family: var(--font-sans); font-size: 18px; font-weight: 700 !important; line-height: 1.25; color: inherit; }
  .lc__texte { font-size: 14px; line-height: 1.4; }
  .lc__corps { display: flex; flex-direction: column; gap: 6px; }
  .ft--tuiles .lc__lien { min-height: 120px; padding: 22px; gap: 12px; background: var(--rub-soft); }
  .ft--tuiles .lc__texte { color: var(--c-text-body); }
  .lc__point { width: 14px; height: 14px; border-radius: 50%; background: var(--rub); }
  .ft--rubriques .lc__lien { overflow: hidden; border-radius: var(--radius-xl); background: var(--rub); color: #fff; min-height: 190px; justify-content: flex-end; }
  .ft--rubriques .lc__lien:hover { color: #fff; transform: translateY(-3px); }
  .ft--rubriques .lc__corps { padding: 18px 20px 22px; }
  .ft--rubriques .lc__titre { font-family: var(--font-title); font-size: 22px; line-height: 1.1; }
  .ft--rubriques .lc__texte { font-size: 14.5px; }
  .lc__media { display: block; background: var(--rub-soft); }
  .lc__media :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; }
  @media (prefers-reduced-motion: reduce) { .lc__lien { transition: none; } .lc__lien:hover { transform: none; } }

  .ft :global(.link-more) { background: none; color: var(--c-link); padding: 0; min-height: 0; text-decoration: underline; text-underline-offset: 3px; font-size: var(--fs-base); }
  .ft { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px; }
  .ft--grille-icones, .ft--comparatif, .ft--paires { grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); }
  .ft--grille-icones .ft__item { border: 1px solid var(--c-border); border-radius: var(--radius-lg); padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  .ft__illustration { min-width: 0; }

  /* comparatif : cartes blanches, titre en petites capitales */
  .ft--comparatif .ft__item { border-radius: var(--radius-lg); padding: 32px; background: var(--c-surface); display: flex; flex-direction: column; }
  :global(.bg-clair) .ft--comparatif .ft__item:not(.ft__item--avant) { background: var(--c-surface-alt); }
  .ft__etiquette { font-family: var(--font-sans); font-size: 14px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-text-muted); }
  .ft--comparatif .ft__corps { gap: 14px; }
  .ft--comparatif .ft__texte { font-size: var(--fs-lg); line-height: 1.55; color: var(--c-text-body); }
  .ft__item--avant .ft__etiquette { color: var(--c-peche, #fff); }

  /* paires : deux arguments par carte, fond alterné */
  .ft--paires .ft__item { display: flex; flex-direction: column; gap: 22px; padding: clamp(24px, 2.5vw, 36px); border-radius: var(--radius-xl); background: var(--c-surface-alt); }
  :global(.bg-alt) .ft--paires .ft__item { background: var(--c-surface); }
  .ft--paires .ft__titre { font-size: 20px; }
  .ft--paires .ft__texte { font-size: var(--fs-md); }

  /* étapes : trait au-dessus, grand chiffre */
  .ft--etapes-numerotees { grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 48px; counter-reset: none; }
  .ft--etapes-numerotees .ft__item { display: flex; flex-direction: column; gap: 18px; padding-top: 28px; border-top: 2px solid var(--c-ink, var(--c-text)); }
  .ft__num { font-family: var(--font-title); font-size: 64px; line-height: 1; color: var(--c-accent); }
  .ft--etapes-numerotees .ft__corps { gap: 18px; }
  .ft--etapes-numerotees .ft__titre { font-size: var(--fs-h3); }
  .ft--etapes-numerotees .ft__texte { font-size: var(--fs-lg); line-height: 1.6; color: var(--c-text-body); }

  .ft--liste { max-width: 820px; gap: 0; }
  .ft--liste .ft__item { display: flex; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--c-border); }
  .ft__icone { width: 44px; height: 44px; flex: none; border-radius: 12px; display: grid; place-items: center; background: var(--c-surface-alt); color: var(--c-primary); }
  /* Carte mise en avant : fond primaire, textes clairs */
  .ft__item--avant { position: relative; background: var(--c-primary) !important; border-color: var(--c-primary) !important; }
  .ft__item--avant .ft__titre { color: var(--c-on-dark); }
  .ft__item--avant .ft__texte { color: var(--c-on-dark) !important; }
  .ft__item--avant .ft__icone { background: rgb(255 255 255 / 0.12); color: var(--c-peche, #fff); }
  .ft__badge { position: absolute; top: -12px; right: 18px; background: var(--c-accent); color: var(--c-accent-ink); font-size: 12px; font-weight: 600; padding: 4px 12px; border-radius: var(--radius-pill); }
  .ft__corps { display: flex; flex-direction: column; gap: 6px; }
  .ft__titre { font-family: var(--font-sans); font-size: var(--fs-lg); font-weight: 600; color: var(--c-text-strong); }
  .ft__texte { font-size: var(--fs-md); line-height: 1.55; color: var(--c-text-body); }
  :global(.on-dark) .ft__titre { color: var(--c-on-dark); }
  :global(.on-dark) .ft__texte { color: var(--c-on-dark-body); }
  :global(.on-dark) .ft__item { border-color: var(--c-border-dark); }
</style>
