---
/** Scores PageSpeed réellement mesurés (mobile, ordinateur) ; rien n'est affiché sans score. */
import Anneau from './Anneau.astro';
const { score_mobile, score_ordinateur, date, legende } = Astro.props;
---
{(score_mobile !== undefined || score_ordinateur !== undefined) && (
  <figure class="ps">
    {legende && <figcaption class="ps__legende">{legende}</figcaption>}
    <div class="ps__scores">
      {score_mobile !== undefined && <div><Anneau score={score_mobile} taille={104} /><span>Mobile</span></div>}
      {score_ordinateur !== undefined && <div><Anneau score={score_ordinateur} taille={104} /><span>Ordinateur</span></div>}
    </div>
    <span class="ps__note">Score sur 100.{date && ` Relevé du ${date}.`}</span>
  </figure>
)}
<style>
  .ps { margin: 0; height: 100%; display: flex; flex-direction: column; justify-content: space-between; gap: 28px; padding: clamp(24px, 2.5vw, 36px); border-radius: 24px; background: #fff; border: 1px solid var(--c-border); }
  .ps__legende { font-size: 15px; font-weight: 600; color: var(--c-text-muted); }
  .ps__scores { display: flex; gap: 28px; align-items: center; }
  .ps__scores div { display: flex; flex-direction: column; align-items: center; gap: 10px; font-size: 15px; color: var(--c-text-body); }
  .ps__note { font-size: 14px; color: var(--c-text-muted); }
</style>
