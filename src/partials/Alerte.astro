---
/** Bandeau d'alerte (data/alerte.json) ; masqué après « jusqu_au », aussi dans le navigateur. */
import donnees from '../../data/alerte.json';
import { alerte } from '../schemas/alerte';
const a = alerte.parse(donnees);
const aujourdhui = new Date().toISOString().slice(0, 10);
const visible = a.actif && a.message && (!a.jusqu_au || a.jusqu_au >= aujourdhui);
const libelle = { info: 'Information', important: 'Vigilance', urgent: 'Alerte' }[a.niveau];
---
{visible && (
  <aside class:list={['alerte', `alerte--${a.niveau}`]} aria-label={`${libelle} de la commune`} data-jusqu={a.jusqu_au}>
    <div class="alerte__inner">
      <span class="alerte__niveau">{libelle}</span>
      <p class="alerte__texte">{a.message}</p>
      {a.lien && <a class="alerte__lien" href={a.lien.href}>{a.lien.label}</a>}
    </div>
  </aside>
)}
<script is:inline>
  (function () { var b = document.querySelector('.alerte[data-jusqu]'); if (b && b.dataset.jusqu < new Date().toISOString().slice(0, 10)) b.remove(); })();
</script>
<style>
  .alerte { font-size: 14.5px; line-height: 1.45; }
  .alerte__inner { max-width: var(--container); margin: 0 auto; padding: 10px var(--gutter); display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; }
  .alerte__niveau { font-weight: 700; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; padding: 4px 10px; border-radius: var(--radius-pill); }
  .alerte__texte { flex: 1; min-width: 240px; }
  .alerte__lien { font-weight: 700; color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .alerte__lien:hover { color: inherit; text-decoration-thickness: 2px; }
  .alerte--info { background: var(--c-municipale-soft); color: var(--c-ink); }
  .alerte--info .alerte__niveau { background: var(--c-primary); color: #fff; }
  .alerte--important { background: var(--c-soleil); color: var(--c-ink); }
  .alerte--important .alerte__niveau { background: var(--c-ink); color: var(--c-soleil); }
  .alerte--urgent { background: #B42318; color: #fff; }
  .alerte--urgent .alerte__niveau { background: #fff; color: #B42318; }
</style>
