---
import Embleme from './Embleme.astro';
import Silhouette from './Silhouette.astro';
import site from '../../data/site.json';
import { navigation } from '../lib/site';
const nav = await navigation();
const annee = new Date().getFullYear();
const RUBANS = ['municipale', 'democratie', 'quotidien', 'associations', 'culture'];
---
<footer class="footer">
  <div class="footer__decor" aria-hidden="true">
    <Silhouette />
    <div class="footer__ruban">{RUBANS.map((c) => <span style={`background: var(--c-${c})`}></span>)}<span style="background: var(--c-soleil)"></span></div>
  </div>
  <div class="footer__corps">
    <div class="footer__grille">
      <div class="footer__marque">
        <Embleme hauteur={96} blanc />
        <div class="footer__identite">
          <span class="footer__nom">{site.adresse.ville}</span>
          <span class="footer__zone">{site.zone_resume}.<br />{site.baseline}.</span>
          <span class="footer__adresse">{site.adresse.rue}, {site.adresse.code_postal} {site.adresse.ville}</span>
        </div>
      </div>
      {nav.colonnes.filter((c) => c.liens.length).map((c) => (
        <nav class="footer__col" aria-label={c.titre}>
          <h2 class="footer__titre">{c.titre}</h2>
          <ul>{c.liens.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <div class="footer__bas">
      <span>© {annee} {site.nom}</span>
      <ul class="footer__legal">
        <li><a href="/plan-du-site">Plan du site</a></li>
        {nav.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
<style>
  .footer { background: var(--c-ink); color: var(--c-on-dark-muted); margin-top: var(--section-y-compact); }
  .footer__decor { background: var(--c-surface); }
  .footer__decor :global(.silhouette) { margin-bottom: -2px; }
  .footer__ruban { display: flex; height: 6px; border-top: 3px solid var(--c-primary); }
  .footer__ruban span { flex: 1; }
  .footer__corps { max-width: var(--container); margin: 0 auto; padding: 52px var(--gutter) 28px; }
  .footer__grille { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px; }
  .footer__marque { display: flex; gap: 16px; align-items: flex-start; grid-column: span 1; }
  .footer__identite { display: flex; flex-direction: column; gap: 8px; font-size: 14px; line-height: 1.5; }
  .footer__nom { font-family: var(--font-title); font-weight: 800; font-size: 30px; line-height: 1; color: #fff; }
  .footer__col { display: flex; flex-direction: column; gap: 8px; font-size: 14.5px; }
  .footer__titre { font-family: var(--font-sans); font-size: 15px; font-weight: 700 !important; color: var(--c-soleil); margin: 0 0 4px; }
  .footer ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .footer a { color: var(--c-on-dark-muted); }
  .footer a:hover { color: #fff; text-decoration: underline; }
  .footer__bas { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--c-border-dark); display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; font-size: 13px; }
  .footer .footer__legal { flex-direction: row; flex-wrap: wrap; gap: 8px 20px; }
</style>
