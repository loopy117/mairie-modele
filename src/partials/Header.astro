---
import Logo from './Logo.astro';
import Alerte from './Alerte.astro';
import site from '../../data/site.json';
import { navigation } from '../lib/site';
interface Props { courant: string; landing?: boolean }
const { courant, landing = false } = Astro.props;
const nav = await navigation();
const actif = (href: string) => courant === href || (href !== '/' && courant.startsWith(href + '/'));
const externe = (href: string) => /^https?:\/\//.test(href);
---
<Alerte />
<header class="header">
  <div class="header__inner">
    <a class="marque" href="/" aria-label={`${site.nom} — accueil`}>
      <Logo />
    </a>
    {!landing && (
      <details class="nav-mobile">
        <summary class="nav-mobile__bouton"><span class="visually-hidden">Menu</span><span class="burger" aria-hidden="true"></span></summary>
      </details>
    )}
    <nav id="menu" class:list={['nav', landing && 'nav--landing']} aria-label="Menu principal">
      <ul class="nav__liste">
        {!landing && nav.menu.map((l) => (
          <li class="nav__item">
            <a class="nav__lien" href={l.href} aria-current={actif(l.href) ? 'page' : undefined} style={l.couleur ? `--rub: var(--c-${l.couleur}); --rub-soft: var(--c-${l.couleur}-soft)` : undefined}>
              {l.couleur && <span class="nav__point" aria-hidden="true"></span>}{l.label}
            </a>
            {l.enfants && l.enfants.filter((x) => x.visible).length > 0 && (
              <ul class="nav__sous">{l.enfants.filter((x) => x.visible).map((x) => <li><a href={x.href}>{x.label}</a></li>)}</ul>
            )}
          </li>
        ))}
        <li class="nav__item">
          <a class="nav__recherche" href="/recherche" aria-current={courant === '/recherche' ? 'page' : undefined}><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><span class="visually-hidden">Rechercher dans le site</span></a>
        </li>
        <li class="nav__item">
          <a class="nav__bouton" href={nav.bouton.href} {...(externe(nav.bouton.href) ? { target: '_blank', rel: 'noopener' } : {})}>
            {nav.bouton.label}{externe(nav.bouton.href) && <span class="visually-hidden"> (nouvelle fenêtre)</span>}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header { background: var(--c-surface); position: relative; z-index: 20; }
  .header__inner { max-width: var(--container); margin: 0 auto; padding: 14px var(--gutter); display: flex; flex-wrap: wrap; gap: 12px 32px; align-items: center; justify-content: space-between; }
  .marque { display: flex; align-items: center; color: var(--c-text); }
  .marque:hover { color: var(--c-text); }
  .nav__liste { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; font-size: 15px; font-weight: 600; }
  .nav__item { position: relative; }
  .nav__lien { --rub: var(--c-ink); --rub-soft: var(--c-surface-alt); display: flex; align-items: center; gap: 8px; min-height: 44px; padding: 9px 14px; border-radius: var(--radius-pill); color: var(--c-text); background: #fff; border: 2px solid var(--rub); transition: background .15s; }
  .nav__lien:hover { background: var(--rub-soft); color: var(--c-text); }
  .nav__lien[aria-current] { background: var(--rub); color: #fff; }
  .nav__lien[aria-current] .nav__point { background: #fff; }
  .nav__point { width: 10px; height: 10px; border-radius: 50%; background: var(--rub); flex: none; }
  .nav__recherche { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 2px solid var(--c-ink); color: var(--c-ink); background: #fff; }
  .nav__recherche:hover, .nav__recherche[aria-current] { background: var(--c-soleil); color: var(--c-ink); }
  .nav__bouton { display: flex; align-items: center; min-height: 44px; padding: 9px 18px; border-radius: var(--radius-pill); background: var(--c-ink); color: var(--c-soleil); }
  .nav__bouton:hover { color: #fff; }
  .nav__sous { display: none; position: absolute; top: calc(100% + 6px); left: 0; min-width: 230px; list-style: none; margin: 0; padding: 8px; background: #fff; border: 1px solid var(--c-border); border-radius: var(--radius-md); box-shadow: 0 14px 36px rgb(29 34 48 / 0.12); z-index: 30; }
  .nav__item:hover .nav__sous, .nav__item:focus-within .nav__sous { display: block; }
  .nav__item:hover .nav__sous::before { content: ''; position: absolute; left: 0; right: 0; top: -8px; height: 8px; }
  .nav__sous a { display: block; padding: 9px 12px; border-radius: 10px; color: var(--c-text); font-weight: 500; }
  .nav__sous a:hover { background: var(--c-surface-alt); color: var(--c-text); }

  .nav-mobile { display: none; }
  @media (max-width: 1100px) {
    .nav-mobile { display: block; margin-left: auto; }
    .nav-mobile__bouton { list-style: none; cursor: pointer; width: 48px; height: 48px; border-radius: var(--radius-pill); border: 2px solid var(--c-ink); display: grid; place-items: center; }
    .nav-mobile__bouton::-webkit-details-marker { display: none; }
    .burger, .burger::before, .burger::after { display: block; width: 18px; height: 2px; background: var(--c-ink); border-radius: 2px; position: relative; }
    .burger::before, .burger::after { content: ''; position: absolute; left: 0; }
    .burger::before { top: -6px; } .burger::after { top: 6px; }
    .nav:not(.nav--landing) { display: none; width: 100%; padding-bottom: 8px; }
    .nav-mobile[open] + .nav { display: block; }
    .nav__liste { flex-direction: column; }
    .nav__sous { display: block; position: static; box-shadow: none; border: 0; padding: 4px 0 4px 18px; }
  }
</style>
