---
import Logo from './Logo.astro';
import Alerte from './Alerte.astro';
import site from '../../data/site.json';
import { navigation } from '../lib/site';
interface Props { courant: string; landing?: boolean }
const { courant, landing = false } = Astro.props;
const nav = await navigation();
const tel = 'tel:+33' + site.telephone.replace(/\s/g, '').replace(/^0/, '');
const actif = (href: string) => courant === href || (href !== '/' && courant.startsWith(href + '/'));
---
<Alerte />
{site.urgence?.actif && (
  <div class="topbar">
    <a class="topbar__urgence" href={tel}><span class="topbar__point" aria-hidden="true"></span>{site.urgence.texte} — {site.telephone}</a>
    <span class="topbar__zones">{site.zone_resume}</span>
  </div>
)}
<header class="header">
  <a class="marque" href="/" aria-label={`${site.nom} — accueil`}>
    <Logo />
    <span class="marque__textes"><span class="visually-hidden">{site.nom}</span><span class="marque__baseline">{site.baseline}</span></span>
  </a>
  {!landing && (
    <details class="nav-mobile">
      <summary class="nav-mobile__bouton"><span class="visually-hidden">Menu</span><span class="burger" aria-hidden="true"></span></summary>
    </details>
  )}
  <nav class:list={['nav', landing && 'nav--landing']} aria-label="Navigation principale">
    {!landing && (
      <ul class="nav__liste">
        {nav.menu.map((l) => (
          <li class="nav__item">
            <a class="nav__lien" href={l.href} aria-current={actif(l.href) ? 'page' : undefined}>{l.label}</a>
            {l.enfants && l.enfants.filter((x) => x.visible).length > 0 && (
              <ul class="nav__sous">{l.enfants.filter((x) => x.visible).map((x) => <li><a href={x.href}>{x.label}</a></li>)}</ul>
            )}
          </li>
        ))}
      </ul>
    )}
    <a class="btn btn--primaire btn--sm nav__cta" href={nav.bouton.href}>{nav.bouton.label}</a>
  </nav>
</header>

<style>
  .topbar { background: var(--c-ink); padding: 9px var(--gutter); display: flex; flex-wrap: wrap; gap: 8px 22px; align-items: center; justify-content: center; }
  .topbar__urgence { display: flex; align-items: center; gap: 8px; font-size: var(--fs-sm); font-weight: 500; color: #fff; }
  .topbar__urgence:hover { color: #fff; text-decoration: underline; }
  .topbar__point { width: 7px; height: 7px; border-radius: 50%; background: var(--c-accent); }
  .topbar__zones { font-size: var(--fs-sm); color: var(--c-on-dark-muted); }

  .header { position: sticky; top: 0; z-index: 20; background: rgb(255 255 255 / 0.94); backdrop-filter: blur(10px); border-bottom: 1px solid var(--c-border-soft); padding: 14px var(--gutter); display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; }
  .marque { display: flex; align-items: center; gap: 12px; }
  .marque__textes { display: flex; flex-direction: column; gap: 1px; }
  .marque__nom { font-size: 21px; font-weight: 700; letter-spacing: 0.01em; color: var(--c-ink); line-height: 1; }
  .marque__baseline { font-size: 11.5px; line-height: 1.35; letter-spacing: 0.02em; color: var(--c-text-muted); max-width: 160px; }
  .nav { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .nav__liste { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .nav__item { position: relative; }
  .nav__lien { display: block; font-size: var(--fs-base); font-weight: 500; color: oklch(0.3 0.02 160); padding: 9px 12px; border-radius: var(--radius-sm); }
  .nav__lien:hover, .nav__lien[aria-current] { background: var(--c-surface-alt); color: var(--c-ink); }
  .nav__sous { display: none; position: absolute; top: 100%; left: 0; min-width: 220px; list-style: none; margin: 0; padding: 8px; background: #fff; border: 1px solid var(--c-border); border-radius: 12px; box-shadow: 0 10px 30px oklch(0.25 0.05 260 / 0.1); }
  .nav__item:hover .nav__sous, .nav__item:focus-within .nav__sous { display: block; }
  .nav__sous a { display: block; padding: 8px 10px; border-radius: 8px; color: var(--c-text); font-size: var(--fs-base); }
  .nav__sous a:hover { background: var(--c-surface-alt); }
  .nav__cta { margin-left: 6px; }

  .nav-mobile { display: none; }
  @media (max-width: 1080px) {
    .nav-mobile { display: block; margin-left: auto; }
    .nav-mobile__bouton { list-style: none; cursor: pointer; width: 44px; height: 44px; border-radius: 10px; border: 1px solid var(--c-border); display: grid; place-items: center; }
    .nav-mobile__bouton::-webkit-details-marker { display: none; }
    .burger, .burger::before, .burger::after { display: block; width: 18px; height: 2px; background: var(--c-ink); border-radius: 2px; position: relative; }
    .burger::before, .burger::after { content: ''; position: absolute; left: 0; }
    .burger::before { top: -6px; } .burger::after { top: 6px; }
    .nav:not(.nav--landing) { display: none; width: 100%; flex-direction: column; align-items: stretch; }
    .nav-mobile[open] + .nav { display: flex; }
    .nav__liste { flex-direction: column; }
    .nav__sous { display: block; position: static; box-shadow: none; border: 0; padding: 0 0 0 12px; }
    .nav__cta { margin: 8px 0 0; }
  }
</style>
